# Port (Render sets this automatically)
PORT=3000

# MongoDB connection string (Atlas: mongodb+srv://user:pass@cluster.mongodb.net/timebomb)
# If this is missing the app runs in MEMORY mode: data is lost on restart.
MONGODB_URI=

# Secret used to sign player/admin sessions. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Admin panel password (username is not needed). Change this before deploying.
ADMIN_PASSWORD=change-me-admin

# BotFather bot token. Used to verify the Telegram Mini App initData, so players
# are identified by their real Telegram account (no sign-up / password).
# Get it from @BotFather -> your bot -> API Token.
TELEGRAM_BOT_TOKEN=

# Optional: allow browser sign-in outside Telegram (for local testing without a bot).
# It is already allowed automatically while TELEGRAM_BOT_TOKEN is empty.
# ALLOW_DEV_LOGIN=1

# Optional: where the app listens. Render needs 0.0.0.0 (set automatically when RENDER=true).
# HOST=127.0.0.1
